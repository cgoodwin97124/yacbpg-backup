title = Yet Another Comic Book Page Generator
description = Yet Another Comic Book Page Generator — describe each panel (characters, location, action) and it renders AI art for every slot, 1–4 images per panel. Multi-page projects, reusable character/location/style libraries, per-panel seeds and protected "keeper" images, storyboard and focus views, file export/import plus one-click GitHub backup. Runs entirely in your browser — no account, no server.
generateImage = {import:text-to-image-plugin}

characters
  none = 
  hero = A fierce cyber-ninja with silver hair, wearing a glowing neon blue visor and dark carbon fiber armor
  villain = A tall mastermind in a pristine white business suit, wearing a gold cybernetic monocle
  sidekick = A young tech-mechanic wearing grease-stained yellow overalls and oversized welding goggles
  civilian = A worried storefront owner wearing a simple brown apron and holding a tablet

locations
  none = 
  city = Rainy dystopian cyberpunk city streets at midnight, towering holographic advertisements, neon wet asphalt
  lab = A high-tech secret laboratory filled with glowing green liquid vats, dangling wires, and server racks
  hideout = An abandoned industrial warehouse with broken windows, shafts of dramatic sunlight, and concrete pillars
  rooftop = High above the city on a skyscraper ledge, dramatic dark clouds, lightning flashing in the background
